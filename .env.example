# Copy to `.env` and fill in. `.env` is git-ignored. Restart the app after edits.
#
# On cPanel you can set these either in this file (python-dotenv reads it) or in
# the "Environment variables" panel of Setup Python App. The panel wins.

# --- Paystack (test mode) -------------------------------------------------
# Get these from https://dashboard.paystack.com/#/settings/developers (TEST keys).
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Split settlement into each cooperative's own subaccount. Leave false to test
# a plain charge (money lands in your main test account); turn on once you've
# created real Paystack subaccounts and stored their codes on ProviderAccount.
PAYSTACK_USE_SUBACCOUNT=false

# Optional: override where Paystack returns the payer after checkout. The web app
# passes its own callback per-request, so this is usually left blank.
# PAYSTACK_CALLBACK_URL=

# --- Flutterwave (optional) ----------------------------------------------
# FLUTTERWAVE_SECRET_HASH=

# ==========================================================================
# Production only (config.settings.prod). Not needed for local dev.
# The app refuses to boot without the required ones.
# ==========================================================================

# Required. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# DJANGO_SECRET_KEY=

# Required. Comma-separated, no scheme, no trailing slash.
# DJANGO_ALLOWED_HOSTS=app.cooperativeos.africa,www.cooperativeos.africa

# Optional. Defaults to https:// + each allowed host. Django needs the scheme
# here or admin/session logins 403 behind cPanel's TLS proxy.
# CSRF_TRUSTED_ORIGINS=https://app.cooperativeos.africa

# --- Database: MySQL / MariaDB (cPanel) -----------------------------------
# Create these in cPanel > MySQL Databases. cPanel prefixes both names with
# your account, e.g. "cpuser_coopdb" / "cpuser_coopapp". Grant ALL PRIVILEGES.
# Requires MySQL >= 8.0.16 or MariaDB >= 10.5 — below MySQL 8.0.16 Django
# silently drops the ledger's CHECK constraints.
# MYSQL_DB=cpuser_coopdb
# MYSQL_USER=cpuser_coopapp
# MYSQL_PASSWORD=change-me
# MYSQL_HOST=localhost
# MYSQL_PORT=3306

# --- Where the built SPA lives --------------------------------------------
# Defaults to <app root>/../frontend/dist, which is right for a full checkout.
# Set it when only backend/ was uploaded and the build sits elsewhere, e.g.
# FRONTEND_DIST=/home/youruser/coop/frontend_dist

# --- Public origin ---------------------------------------------------------
# Required in production. Links inside emails (password reset, welcome) are
# absolute — an email client has no notion of the request, so without this they
# would point at localhost and be useless.
# SITE_URL=https://mycooperativeos.com

# --- Email (SMTP) ----------------------------------------------------------
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_PORT=587
# EMAIL_USE_TLS=true

# --- Only if the SPA is moved to a separate origin -------------------------
# Leave unset for the single-domain layout.
# CORS_ALLOWED_ORIGINS=https://app.cooperativeos.africa

# --- Escape hatches --------------------------------------------------------
# Set false only if the host terminates TLS in a way that loops redirects.
# SECURE_SSL_REDIRECT=true
